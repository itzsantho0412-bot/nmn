rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'loqsandy@gmail.com' ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    // Health probe for testing connection
    match /_health/{docId} {
      allow read, write: if true;
    }

    // Businesses collection
    match /businesses/{businessId} {
      // Single doc read
      allow get: if isSignedIn() && isValidId(businessId);
      // Collection list
      allow list: if isSignedIn();
      // Write operations
      allow create: if isSignedIn() && isValidId(businessId);
      allow update: if isSignedIn() && isValidId(businessId);
      allow delete: if isSignedIn() && isValidId(businessId);

      // Members subcollection
      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(memberId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(memberId);
      }

      // Branches subcollection
      match /branches/{branchId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(branchId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(branchId);
      }

      // Plans subcollection
      match /plans/{planId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(planId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(planId);
      }

      // Attendance subcollection
      match /attendance/{attendanceId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(attendanceId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(attendanceId);
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(invoiceId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(invoiceId);
      }

      // Payments subcollection
      match /payments/{paymentId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(paymentId);
        allow list: if isSignedIn() && isValidId(businessId);
        allow create, update, delete: if isSignedIn() && isValidId(businessId) && isValidId(paymentId);
      }
    }

    // Business Memberships (RBAC & User Affiliation)
    match /business_memberships/{membershipId} {
      allow get: if isSignedIn() && isValidId(membershipId);
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(membershipId);
    }

    // Super Admins list
    match /super_admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
